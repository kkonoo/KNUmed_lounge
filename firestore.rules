rules_version = '2';
// 경북의대 라운지 Firestore 보안 규칙 → Firebase 콘솔 › Firestore Database › 규칙에 그대로 붙여 넣고 게시해요
// 고치면 다시 붙여 넣어야 적용돼요. 화면(js)이 아니라 여기가 데이터를 지켜요
//
// config/admins { uids }             관리자 계정 목록. 누구나 읽음(계정 번호뿐). 관리자만 고침, 마지막 한 분은 못 뺌
//                                     처음 한 번: 아직 없을 때 로그인한 사람이 자기 하나만 넣어 만들 수 있음 (admin/ 처음 설정)
// config/signup { code }             가입 코드. 관리자만
// roster/{메일}                      명단 { name, dept, group, status, at }. 관리자, 그리고 그 메일로 로그인한 본인만 읽음
// members/{uid}                      회원 { email, name, dept, group, active, joinCode, at }
//                                     본인 가입: 명단에 있고(사용 중), 가입 코드가 맞고, 이름·교실·구분이 명단과 같을 때만
// events/{행사}                      친목회 { title, date, time, place, mapUrl, deadline, note, audience, closed, at, by }
// events/{행사}/rsvps/{uid}          참석 { status, name, comment, at }. 본인 것만, 마감 전에만
// adminLog/{자동}                    관리 작업 기록. 관리자만 읽고 더하기만 (고치기·지우기 없음)
// posts/{글}                         자유 게시판 { title, body, by, name, at, editedAt }. 회원만 읽음. 쓴 사람만 고침, 쓴 사람·관리자가 지움
// posts/{글}/comments/{댓글}         댓글 { body, by, name, at }. 회원만 읽음. 고치기 없음, 쓴 사람·관리자가 지움 (글을 지울 때는 글쓴이도)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminsDoc() { return /databases/$(database)/documents/config/admins; }
    function isAdmin() { return signedIn() && exists(adminsDoc()) && request.auth.uid in get(adminsDoc()).data.uids; }
    function myMemberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function me() { return get(myMemberPath()).data; }
    function isMember() { return signedIn() && exists(myMemberPath()) && me().active == true; }
    function text(v, max) { return v is string && v.size() <= max; }
    function filled(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function isGroup(v) { return v in ['기초', '임상']; }

    // ---------- 설정 ----------
    match /config/admins {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids == [request.auth.uid];
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() >= 1
        && request.resource.data.uids.size() <= 20;
    }
    match /config/signup {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code.matches('[a-z0-9가-힣]{2,20}');
    }

    // ---------- 명단 ----------
    function rosterOk(email, d) {
      return email == email.lower() && email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && d.keys().hasOnly(['name', 'dept', 'group', 'status', 'at'])
        && filled(d.name, 20) && text(d.dept, 30) && isGroup(d.group)
        && d.status in ['active', 'inactive']
        && d.at is timestamp;
    }
    match /roster/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && rosterOk(email, request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- 회원 ----------
    function memberOk(d) {
      return d.keys().hasOnly(['email', 'name', 'dept', 'group', 'active', 'joinCode', 'at'])
        && filled(d.email, 100) && filled(d.name, 20) && text(d.dept, 30) && isGroup(d.group)
        && d.active is bool && d.at is timestamp
        && (!('joinCode' in d) || text(d.joinCode, 20));
    }
    function selfJoin(uid, d) {
      let rosterPath = /databases/$(database)/documents/roster/$(d.email);
      let signupPath = /databases/$(database)/documents/config/signup;
      return signedIn() && request.auth.uid == uid
        && d.email == request.auth.token.email
        && exists(rosterPath) && exists(signupPath)
        && get(rosterPath).data.status == 'active'
        && d.joinCode == get(signupPath).data.code
        && d.name == get(rosterPath).data.name
        && d.dept == get(rosterPath).data.dept
        && d.group == get(rosterPath).data.group
        && d.active == true
        && d.at == request.time;
    }
    match /members/{uid} {
      allow read: if isMember() || isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if memberOk(request.resource.data) && (isAdmin() || selfJoin(uid, request.resource.data));
      allow update: if isAdmin() && memberOk(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- 친목회 ----------
    // 행사 대상(audience): 참석 체크는 대상인 회원만('전체' 또는 회원 구분과 같을 때).
    // 보기는 회원이면 누구나 (날짜·장소는 민감하지 않고, 대상별로 나누는 건 화면이 함). 그래야 목록 읽기가 단순해요
    function eventOk(d) {
      return d.keys().hasOnly(['title', 'date', 'time', 'place', 'mapUrl', 'deadline', 'note', 'audience', 'closed', 'at', 'by'])
        && filled(d.title, 60)
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.time is string && (d.time == '' || d.time.matches('[0-9]{2}:[0-9]{2}'))
        && text(d.place, 80)
        && d.mapUrl is string && (d.mapUrl == '' || (d.mapUrl.size() <= 500 && d.mapUrl.matches('https://.+')))
        && (d.deadline == null || d.deadline is timestamp)
        && text(d.note, 1000)
        && d.audience in ['기초', '임상', '전체']
        && d.closed is bool
        && d.at is timestamp && d.by is string;
    }
    function isOpen(e) { return !e.closed && (e.deadline == null || request.time < e.deadline); }
    match /events/{eid} {
      allow read: if isAdmin() || isMember();
      allow create: if isAdmin() && eventOk(request.resource.data) && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow update: if isAdmin() && eventOk(request.resource.data);
      allow delete: if isAdmin();

      function ev() { return get(/databases/$(database)/documents/events/$(eid)).data; }
      function forMe() { return ev().audience in ['전체', me().group]; }
      match /rsvps/{uid} {
        allow read: if isAdmin() || isMember();
        allow create, update: if isMember() && request.auth.uid == uid && forMe() && isOpen(ev())
          && request.resource.data.keys().hasOnly(['status', 'name', 'comment', 'at'])
          && request.resource.data.status in ['yes', 'maybe', 'no']
          && request.resource.data.name == me().name
          && text(request.resource.data.comment, 60)
          && request.resource.data.at == request.time;
        allow delete: if isAdmin() || (isMember() && request.auth.uid == uid && isOpen(ev()));
      }
    }

    // ---------- 자유 게시판 ----------
    // 이름은 회원 이름 그대로(실명), 시각은 서버 시각. 글을 지울 때는 댓글을 먼저 지우고 글을 지워요(한 번에)
    function postOk(d) {
      return d.keys().hasOnly(['title', 'body', 'by', 'name', 'at', 'editedAt'])
        && d.keys().hasAll(['title', 'body', 'by', 'name', 'at', 'editedAt'])
        && filled(d.title, 80) && filled(d.body, 4000)
        && d.by is string && d.name is string && d.at is timestamp
        && (d.editedAt == null || d.editedAt is timestamp);
    }
    match /posts/{pid} {
      allow read: if isMember();
      allow create: if isMember() && postOk(request.resource.data)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.at == request.time
        && request.resource.data.editedAt == null;
      allow update: if isMember() && resource.data.by == request.auth.uid && postOk(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'editedAt'])
        && request.resource.data.editedAt == request.time;
      allow delete: if isAdmin() || (isMember() && resource.data.by == request.auth.uid);

      function postPath() { return /databases/$(database)/documents/posts/$(pid); }
      match /comments/{cid} {
        allow read: if isMember();
        allow create: if isMember() && exists(postPath())
          && request.resource.data.keys().hasOnly(['body', 'by', 'name', 'at'])
          && filled(request.resource.data.body, 1000)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.name == me().name
          && request.resource.data.at == request.time;
        allow delete: if isAdmin()
          || (isMember() && resource.data.by == request.auth.uid)
          || (isMember() && get(postPath()).data.by == request.auth.uid && !existsAfter(postPath()));
      }
    }

    // ---------- 관리 작업 기록 ----------
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['at', 'by', 'byName', 'action', 'target'])
        && request.resource.data.at == request.time
        && request.resource.data.by == request.auth.uid
        && text(request.resource.data.byName, 20)
        && filled(request.resource.data.action, 60)
        && text(request.resource.data.target, 200);
    }
  }
}
